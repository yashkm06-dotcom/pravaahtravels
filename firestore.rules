rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'yash.km06@gmail.com' ||
        request.auth.token.email == 'admin@pravaahtravels.com' ||
        request.auth.token.email.matches('(?i)^[a-zA-Z0-9._%+-]+@pravaahtravels\\.com$')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBookingOwner(resourceData) {
      return isSignedIn() && (
        resourceData.userId == request.auth.uid ||
        resourceData.customerId == request.auth.uid ||
        resourceData.customerEmail == request.auth.token.email ||
        resourceData.email == request.auth.token.email
      );
    }

    function isSafeCustomerBookingUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isBookingOwner(resource.data) &&
        changedKeys.hasOnly([
          'status',
          'updatedAt',
          'paymentStatus',
          'paymentSubmittedAt',
          'paymentSubmissionStatus',
          'paymentHistory'
        ]) &&
        (!changedKeys.hasAny(['status']) || request.resource.data.status == 'Cancelled') &&
        (!changedKeys.hasAny(['paymentStatus']) || request.resource.data.paymentStatus == 'Pending Verification');
    }

    // Global safety net.
    match /{document=**} {
      allow read, write: if false;
    }

    match /packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /imports/{importId} {
      allow read, write: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /bookings/{bookingId} {
      allow create: if isAdmin() || (isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.customerEmail == request.auth.token.email);
      allow read: if isAdmin() || isBookingOwner(resource.data);
      allow update: if isAdmin() || isSafeCustomerBookingUpdate();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /private/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /analytics_events/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /activityItems/{activityItemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /activityRecommendations/{recommendationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /featuredCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hotels/{hotelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /sent_emails/{emailId} {
      allow read, write: if isAdmin();
    }
  }
}
