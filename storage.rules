rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'yash.km06@gmail.com' ||
        request.auth.token.email == 'admin@pravaahtravels.com' ||
        request.auth.token.email.matches('(?i)^[a-zA-Z0-9._%+-]+@pravaahtravels\\.com$')
      );
    }

    match /cms/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
